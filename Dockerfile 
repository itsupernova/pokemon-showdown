# 1. Use Node 22
FROM node:22-bookworm-slim

# 2. Set the working directory
WORKDIR /home/user/app

# 3. Copy your project files
COPY --chown=1000 . .

# 4. CRITICAL FIX: Create the missing logs folder
# This prevents the "ENOENT: no such file or directory, scandir '/logs/repl'" error
RUN mkdir -p logs/repl && chown -R 1000:1000 logs

# 5. Install and Build
RUN npm install
RUN npm run build

# 6. Set the Port and start
EXPOSE 7860
ENV PORT=7860

# Command to start the server
CMD ["node", "pokemon-showdown", "7860"]